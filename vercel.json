{
  "rewrites": [
    {
      "source": "/api/yoomoney/notify",
      "destination": "/api/shop/webhook"
    },
    {
      "source": "/api/matchmaking/resign",
      "destination": "/api/matchmaking/move"
    },
    {
      "source": "/api/shop/status",
      "destination": "/api/shop?status=1"
    }
  ],
  "crons": [
    {
      "path": "/api/retention-cron",
      "schedule": "0 8 * * *"
    }
  ]
}